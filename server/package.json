{
  "name": "fixgarasi-server",
  "version": "1.0.0",
  "description": "Backend REST API for FixGarasi SaaS",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc && prisma generate",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:push:neon": "prisma db push --schema=prisma/schema.postgresql.prisma",
    "seed": "ts-node-dev --transpile-only src/seed.ts",
    "test:api": "ts-node-dev --transpile-only src/test_api.ts"
  },
  "keywords": [
    "saas",
    "fixgarasi",
    "vehicle-management",
    "service-tracker",
    "express",
    "prisma",
    "neon-postgres"
  ],
  "author": "FixGarasi",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "midtrans-client": "^1.4.3",
    "multer": "^1.4.5-lts.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/midtrans-client": "^1.4.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.9",
    "prisma": "^6.4.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.1"
  }
}
