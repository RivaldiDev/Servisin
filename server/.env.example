PORT=5000
NODE_ENV=development

# Database Connection (Neon Serverless PostgreSQL for Production / SQLite for Dev)
# Example Neon: "postgresql://username:password@ep-sample-123.ap-southeast-1.aws.neon.tech/fixgarasi_db?sslmode=require"
DATABASE_URL="file:./dev.db"

JWT_SECRET="fixgarasi_super_secret_jwt_key_min_32_characters_2026"
JWT_EXPIRES_IN="7d"

# Midtrans Payment Gateway Configuration
MIDTRANS_SERVER_KEY="SB-Mid-server-YOUR_SERVER_KEY"
MIDTRANS_CLIENT_KEY="SB-Mid-client-YOUR_CLIENT_KEY"
MIDTRANS_IS_PRODUCTION=false
CLIENT_URL="http://localhost:5173"
